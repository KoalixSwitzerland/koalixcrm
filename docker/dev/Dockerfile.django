# docker/dev/Dockerfile.django
#
# Used by: docker-compose (dev environment, unit tests, integration tests)
# Source code is NOT copied here -- it is bind-mounted at runtime so that
# file changes are reflected immediately (Django auto-reload via runserver).
#
# Differences from docker/prod/Dockerfile.django:
#   - All requirements files installed (django + celery + test)
#   - debugpy installed and listening on port 5678
#   - Starts with `runserver` instead of Gunicorn
#   - No COPY of application code

FROM python:3.13

ARG APP_VERSION=vX.Y.Z-develop
ARG VCS_REF=unknown

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    libcurl4-openssl-dev \
    libssl-dev \
    chromium \
    chromium-driver \
 && rm -rf /var/lib/apt/lists/*

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    KOALIXCRM_VERSION=${APP_VERSION}

LABEL org.opencontainers.image.title="koalixcrm-django-dev" \
      org.opencontainers.image.version=${APP_VERSION} \
      org.opencontainers.image.revision=${VCS_REF} \
      org.opencontainers.image.source="https://github.com/KoalixSwitzerland/koalixcrm"

WORKDIR /usr/src/app

COPY docker/requirements/django.txt docker/requirements/celery.txt docker/requirements/test.txt /usr/src/app/
RUN pip install --upgrade pip && \
    pip install --no-cache-dir \
        -r django.txt \
        -r celery.txt \
        -r test.txt && \
    pip install --no-cache-dir debugpy

EXPOSE 8000
EXPOSE 5678

COPY docker/dev/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

CMD ["/usr/local/bin/entrypoint.sh"]
