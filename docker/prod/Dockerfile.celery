# docker/prod/Dockerfile.celery
#
# Production Celery worker for koalixcrm PDF export microservice.
# Application code is COPIED into the image (no bind mounts).

FROM python:3.13

ARG APP_VERSION=vX.Y.Z-develop
ARG VCS_REF=unknown

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    libcurl4-openssl-dev \
    libssl-dev \
 && rm -rf /var/lib/apt/lists/*

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    KOALIXCRM_VERSION=${APP_VERSION}

LABEL org.opencontainers.image.title="koalixcrm-celery" \
      org.opencontainers.image.version=${APP_VERSION} \
      org.opencontainers.image.revision=${VCS_REF} \
      org.opencontainers.image.source="https://github.com/KoalixSwitzerland/koalixcrm"

WORKDIR /usr/src/app

COPY docker/requirements/celery.txt /usr/src/app/
RUN pip install --upgrade pip && \
    pip install --no-cache-dir -r celery.txt

# Copy application code
COPY koalixcrm_microservices /usr/src/app/koalixcrm_microservices
COPY koalixcrm_mq_commands /usr/src/app/koalixcrm_mq_commands
COPY koalixcrm_utils /usr/src/app/koalixcrm_utils

CMD ["celery", "-A", "koalixcrm_microservices.celery_app", "worker", "-l", "info", "-B"]
