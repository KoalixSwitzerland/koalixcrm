# docker/prod/Dockerfile.django
#
# Production Django container for koalixcrm.
# Application code is COPIED into the image (no bind mounts).
# Served via Gunicorn instead of Django runserver.

FROM python:3.13

ARG APP_VERSION=vX.Y.Z-develop
ARG VCS_REF=unknown

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    libcurl4-openssl-dev \
    libssl-dev \
    gettext \
 && rm -rf /var/lib/apt/lists/*

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    KOALIXCRM_VERSION=${APP_VERSION}

LABEL org.opencontainers.image.title="koalixcrm-django" \
      org.opencontainers.image.version=${APP_VERSION} \
      org.opencontainers.image.revision=${VCS_REF} \
      org.opencontainers.image.source="https://github.com/KoalixSwitzerland/koalixcrm"

WORKDIR /usr/src/app

COPY docker/requirements/django.txt /usr/src/app/
RUN pip install --upgrade pip && \
    pip install --no-cache-dir -r django.txt && \
    pip install --no-cache-dir gunicorn

# Copy application code
COPY koalixcrm /usr/src/app/koalixcrm
COPY koalixcrm_microservices /usr/src/app/koalixcrm_microservices
COPY koalixcrm_mq_commands /usr/src/app/koalixcrm_mq_commands
COPY koalixcrm_utils /usr/src/app/koalixcrm_utils
COPY projectsettings /usr/src/app/projectsettings
COPY manage.py /usr/src/app/manage.py

# Belt-and-suspenders: strip any test packages that slipped past .dockerignore
# so factory_boy / Faker and other test-only imports never enter the prod image
# (org ADR-0012).
RUN find /usr/src/app -type d -name tests -prune -exec rm -rf {} +

# Stamp the resolved version into the Python package so `koalixcrm.version`
# reports the same value as the image label / KOALIXCRM_VERSION env var.
RUN printf 'KOALIXCRM_VERSION = "%s"\n' "${APP_VERSION}" > /usr/src/app/koalixcrm/version.py

# Compile gettext message catalogs (.po -> .mo) at build time so the binary
# .mo files do not need to be committed to git. Run per-app with django-admin
# so no Django settings/env are required during the build.
RUN for appdir in koalixcrm/*/; do \
        if [ -d "${appdir}locale" ]; then \
            (cd "$appdir" && django-admin compilemessages); \
        fi; \
    done

EXPOSE 8000

COPY docker/prod/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

CMD ["/usr/local/bin/entrypoint.sh"]
