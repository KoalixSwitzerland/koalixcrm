# Dockerfile-Celery
#
# Celery worker for koalixcrm PDF export microservice.
# Source code is bind-mounted at runtime (dev mode).
# watchdog restarts the Celery worker automatically on .py file changes.

FROM ghcr.io/koalixswitzerland/koalixcrm-dev-container:main

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    libcurl4-openssl-dev \
    libssl-dev \
 && rm -rf /var/lib/apt/lists/*

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /usr/src/app

COPY requirements/celery_requirements.txt /tmp/celery_requirements.txt
RUN pip install --upgrade pip && \
    pip install --no-cache-dir -r /tmp/celery_requirements.txt && \
    pip install --no-cache-dir "watchdog[watchmedo]"

# Source code is mounted at runtime
CMD ["watchmedo", "auto-restart", \
     "--directory=/usr/src/app", \
     "--pattern=*.py", \
     "--recursive", \
     "--", \
     "celery", "-A", "koalixcrm_microservices.celery_app", "worker", "-l", "info", "-B"]
