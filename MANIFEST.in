recursive-include koalixcrm/crm/static *
recursive-include koalixcrm/crm/locale *
recursive-include koalixcrm/crm/templates *
recursive-include koalixcrm/accounting/static *
recursive-include koalixcrm/accounting/locale *
recursive-include koalixcrm/accounting/templates *
recursive-include koalixcrm/subscriptions/static *
recursive-include koalixcrm/subscriptions/locale *
recursive-include koalixcrm/djangoUserExtension/static *
recursive-include koalixcrm/djangoUserExtension/locale *

# Keep test code out of the sdist (org ADR-0012). find_packages already drops
# the tests packages from the wheel; these rules stop the sdist carrying them.
prune tests
global-exclude */tests/* */tests/factories/*
